# ─── Auth (pick ONE path) ─────────────────────────────────────────────────────
# Path A — GitHub App (recommended, read-only). One App per org/user you monitor.
# See docs/GITHUB_APP.md
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Optional. If empty, the server lists installations of this App.
GITHUB_APP_INSTALLATION_ID=

# Optional second App (another org or personal account)
GITHUB_APP_2_ID=
GITHUB_APP_2_PRIVATE_KEY=
GITHUB_APP_2_INSTALLATION_ID=

# Path B — PAT fallback (fine-grained or classic with read access to PRs)
GITHUB_TOKEN=

# ─── Target ───────────────────────────────────────────────────────────────────
# Your GitHub login — used by the "Minhas PRs" filter (PR author)
PR_ORBIT_USER=your-login

# Hint when an App has more than one installation
PR_ORBIT_ORG=YOUR_ORG

# Owners to search (orgs and/or users; comma-separated; overrides PR_ORBIT_ORG).
# Personal accounts use user: in Search; orgs use org: (resolved automatically).
PR_ORBIT_ORGS=YOUR_ORG

# Optional: pin repos (skips auto-discovery and search). owner/name, comma-separated
# PR_ORBIT_REPOS=YOUR_ORG/my-repo,your-login/other-repo

# ─── Shepherd overlay (optional) ──────────────────────────────────────────────
# Bearer token for agent ingest endpoints.
# Empty disables writes (503). Use SHEPHERD_ALLOW_ANON=1 only for local demos.
SHEPHERD_INGEST_TOKEN=
# SHEPHERD_ALLOW_ANON=1
SHEPHERD_HINT_TTL_MS=120000
SHEPHERD_AGENT_TTL_MS=300000

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
# Loopback by default. Use 0.0.0.0 only behind a trusted proxy/VPN.
HOST=127.0.0.1
# Comma-separated hostnames accepted in the Host header for remote deployments.
# TRUSTED_HOSTS=panel.example.com
# Set to 1 in production so Fastify also serves the built SPA (client/dist)
SERVE_CLIENT=1
CORS_ORIGIN=
# Background GitHub sync interval in milliseconds
PR_ORBIT_POLL_MS=120000
# Minimum interval between manual sync requests
PR_ORBIT_MANUAL_SYNC_MIN_MS=30000
# Optional explicit path to an env file. No parent-directory discovery is performed.
# ENV_FILE=/absolute/path/to/orbita-prs.env
